import React, { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";

export default function RareArtsTablet() {
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [image, setImage] = useState(null);
  const [preview, setPreview] = useState(null);

  const handleImageUpload = (e) => {
    const file = e.target.files[0];
    setImage(file);
    setPreview(URL.createObjectURL(file));
  };

  const mintNFT = () => {
    // Placeholder for smart contract integration
    alert(`Minting NFT: ${title}`);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-indigo-950 to-black text-white p-6">
      <h2 className="text-3xl font-bold mb-4 text-center">Rare Arts Tablet</h2>
      <p className="text-center text-sm opacity-60 mb-6">Mint your cosmic glyphs into sacred digital sigils</p>

      <Card className="max-w-3xl mx-auto bg-gray-900 border-gray-700">
        <CardContent className="p-4 space-y-4">
          <Input
            type="text"
            placeholder="Title of your Sigil"
            value={title}
            onChange={(e) => setTitle(e.target.value)}
            className="bg-black text-white"
          />
          <Textarea
            placeholder="Describe your divine glyph..."
            rows={4}
            value={description}
            onChange={(e) => setDescription(e.target.value)}
            className="bg-black text-white"
          />
          <Input type="file" accept="image/*" onChange={handleImageUpload} className="bg-black text-white" />

          {preview && (
            <div className="border border-gray-600 p-2 rounded">
              <img src={preview} alt="Preview" className="w-full max-h-96 object-contain" />
            </div>
          )}

          <div className="text-center pt-4">
            <Button onClick={mintNFT} disabled={!title || !image}>
              Mint Sigil NFT
            </Button>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
