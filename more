import javax.sound.sampled.*;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

class DrumSynthesizer {
    private List<Voice> voices;
    private final int polyphony = 8;
    private StepSequencer sequencer;

    public DrumSynthesizer() {
        voices = new ArrayList<>(polyphony);
        for (int i = 0; i < polyphony; i++) {
            voices.add(new Voice());
        }
        sequencer = new StepSequencer(voices);
    }

    public void playNote(int note) {
        for (Voice voice : voices) {
            if (!voice.isActive()) {
                voice.play(note);
                break;
            }
        }
    }

    public void stopNote(int note) {
        for (Voice voice : voices) {
            if (voice.getNote() == note) {
                voice.stop();
                break;
            }
        }
    }

    public void startSequencer() {
        sequencer.start();
    }

    public static void main(String[] args) {
        DrumSynthesizer synth = new DrumSynthesizer();
        synth.startSequencer(); // Start the sequencer
    }
}

